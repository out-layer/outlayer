# Dockerfile for compiling Rust WASM for WASI Preview 1 and Preview 2
# Supports both wasm32-wasip1 (WasmEdge) and wasm32-wasip2 (wasmtime)

# Pinned by digest, not by tag. This image decides which toolchain produces the wasm whose
# hash the enclave attests, so a floating base would mean the same source can compile to a
# different binary — the exact thing pinning Cargo.lock in every example is meant to prevent.
# rust:1.97 as of 2026-08-14, amd64; bump deliberately, never implicitly. A bump
# gives every GitHub-built project a new hash, so it is also the moment to clear
# the coordinator's wasm cache: that cache is keyed by repo:commit:build_target
# and says nothing about the compiler, so a commit already built keeps serving
# its old bytes while a fresh local build of the same commit gives the new hash.
#
# The digest names the amd64 image on purpose. Everyone — the server and anyone
# checking a hash on a laptop — then compiles in the same image, emulated where
# it has to be, and there is no second variant to explain a mismatch with.
FROM rust:1.97@sha256:4277ce860337f6cfa1b679891bbf689a447f4b3f4f55701742614ad31321cee7

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    pkg-config \
    libssl-dev \
    clang \
    llvm \
    binaryen=120-4 \
    && rm -rf /var/lib/apt/lists/*
# binaryen brings wasm-opt, which rewrites every wasip1 module and so decides
# its hash the same way wasm-tools decides a component's. Pinned to the exact
# package, because apt otherwise serves whatever the archive holds on the day of
# the build: the version moved 108 → 120 on its own when the base image was
# bumped, and a move like that gives every wasip1 project a new hash with
# nothing in its source having changed.
#
# When Debian drops 120-4 from the archive this build will fail. That is the
# intended direction: a loud failure while someone is rebuilding the image,
# rather than a quiet one later, in a project whose secret stopped opening.

# Install WASI SDK for compiling C code (ring library) to WASM
ENV WASI_VERSION=25
ENV WASI_VERSION_FULL=${WASI_VERSION}.0
ENV WASI_SDK_PATH=/opt/wasi-sdk

# Detect architecture and download appropriate WASI SDK
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        WASI_ARCH="x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        WASI_ARCH="arm64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    wget -q https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_VERSION}/wasi-sdk-${WASI_VERSION_FULL}-${WASI_ARCH}-linux.tar.gz && \
    tar xzf wasi-sdk-${WASI_VERSION_FULL}-${WASI_ARCH}-linux.tar.gz && \
    mv wasi-sdk-${WASI_VERSION_FULL}-${WASI_ARCH}-linux ${WASI_SDK_PATH} && \
    rm wasi-sdk-${WASI_VERSION_FULL}-${WASI_ARCH}-linux.tar.gz

# Set environment variables for WASI compilation
ENV CC_wasm32_wasip1=${WASI_SDK_PATH}/bin/clang
ENV AR_wasm32_wasip1=${WASI_SDK_PATH}/bin/llvm-ar
ENV CARGO_TARGET_WASM32_WASIP1_LINKER=${WASI_SDK_PATH}/bin/clang

# Add WASM targets (wasip1 for WasmEdge, wasip2 for wasmtime)
RUN rustup target add wasm32-wasip1 wasm32-wasip2

# Install wasm-tools for WASI Preview 2 component optimization.
#
# Pinned, because this tool decides the bytes. A wasip2 component is stripped by
# `wasm-tools strip` before it leaves the compiler, so the version installed here
# is part of the hash an enclave measures and part of what a secret locked to a
# build is judged against. An unpinned `cargo install` would give every rebuild
# of this image a different stripper, and with it a new hash for every project
# that had changed nothing.
RUN cargo install wasm-tools --version 1.240.0 --locked

# Install cargo-component for proper WASI Preview 2 CLI component builds
RUN cargo install cargo-component --version 0.21.1 --locked

# Download WASI Preview 1 to Preview 2 adapter for component conversion
RUN mkdir -p /opt/wasi-adapters && \
    wget -q https://github.com/bytecodealliance/wasmtime/releases/download/v28.0.0/wasi_snapshot_preview1.command.wasm \
    -O /opt/wasi-adapters/wasi_snapshot_preview1.command.wasm

# Create workspace directory
WORKDIR /workspace

# Default command (will be overridden by container execution)
CMD ["bash"]

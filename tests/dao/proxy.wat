;; A proxy for tests/dao/requests_e2e.sh: calls request_execution on the main contract with the
;; gas it is given and chains K callbacks on that promise, so the main contract's settlement
;; callback pays for K data receivers and can be made to run out of gas (a stuck request).
;; go(input): [gas u64 LE][k u8][main id length u8][main id][request_execution args JSON];
;; the attached deposit is forwarded.
(module
 (import "env" "input" (func $input (param i64)))
 (import "env" "register_len" (func $register_len (param i64) (result i64)))
 (import "env" "read_register" (func $read_register (param i64 i64)))
 (import "env" "attached_deposit" (func $attached_deposit (param i64)))
 (import "env" "promise_create" (func $promise_create (param i64 i64 i64 i64 i64 i64 i64 i64) (result i64)))
 (import "env" "promise_then" (func $promise_then (param i64 i64 i64 i64 i64 i64 i64 i64 i64) (result i64)))
 (import "env" "promise_return" (func $promise_return (param i64)))
 (import "env" "current_account_id" (func $current_account_id (param i64)))
 (import "env" "promise_result" (func $promise_result (param i64 i64) (result i64)))
 (import "env" "log_utf8" (func $log_utf8 (param i64 i64)))
 (memory (export "memory") 4)
 (data (i32.const 0) "request_execution")
 (data (i32.const 32) "cb")
 (data (i32.const 48) "cb:successful")
 (data (i32.const 64) "cb:failed")
 (data (i32.const 80) "{}")
 (func (export "go")
   (local $len i64) (local $mlen i64) (local $cur i64) (local $p i64) (local $k i64) (local $i i64) (local $last i64)
   (call $input (i64.const 0))
   (local.set $len (call $register_len (i64.const 0)))
   (call $read_register (i64.const 0) (i64.const 1024))
   (call $attached_deposit (i64.const 128))
   (local.set $k (i64.load8_u (i32.const 1032)))
   (local.set $mlen (i64.load8_u (i32.const 1033)))
   (local.set $p (call $promise_create
      (local.get $mlen) (i64.const 1034)
      (i64.const 17) (i64.const 0)
      (i64.sub (i64.sub (local.get $len) (i64.const 10)) (local.get $mlen))
      (i64.add (i64.const 1034) (local.get $mlen))
      (i64.const 128)
      (i64.load (i32.const 1024))))
   (call $current_account_id (i64.const 1))
   (local.set $cur (call $register_len (i64.const 1)))
   (call $read_register (i64.const 1) (i64.const 256))
   (local.set $i (i64.const 0))
   (block $done
     (loop $l
       (local.set $last (call $promise_then (local.get $p)
          (local.get $cur) (i64.const 256)
          (i64.const 2) (i64.const 32)
          (i64.const 2) (i64.const 80)
          (i64.const 144)
          (i64.const 3000000000000)))
       (local.set $i (i64.add (local.get $i) (i64.const 1)))
       (br_if $l (i64.lt_u (local.get $i) (local.get $k)))))
   (call $promise_return (local.get $last)))
 (func (export "cb")
   (if (i64.eq (call $promise_result (i64.const 0) (i64.const 2)) (i64.const 1))
     (then (call $log_utf8 (i64.const 13) (i64.const 48)))
     (else (call $log_utf8 (i64.const 9) (i64.const 64)))))
)
